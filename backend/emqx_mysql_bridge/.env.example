IOT_PORT=3001

IOT_DB_HOST=127.0.0.1
IOT_DB_PORT=3306
IOT_DB_USER=emqx_iot
IOT_DB_PASSWORD=replace-with-a-strong-database-password
IOT_DB_NAME=iot_data
IOT_DB_CONNECTION_LIMIT=10

IOT_ADMIN_USERNAME=admin
IOT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
IOT_ADMIN_DISPLAY_NAME=Lab Admin
IOT_VIEWER_USERNAME=viewer
IOT_VIEWER_PASSWORD=replace-with-a-strong-viewer-password
IOT_VIEWER_DISPLAY_NAME=Read Only

IOT_MAIL_HOST=smtp.example.com
IOT_MAIL_PORT=465
IOT_MAIL_SECURE=true
IOT_MAIL_USER=alerts@example.com
IOT_MAIL_PASS=replace-with-an-smtp-app-password
IOT_MAIL_TO=operator@example.com

IOT_ARCHIVE_DIR=/srv/smart-agriculture/archives
IOT_ARCHIVE_HOUR=0
IOT_ARCHIVE_MINUTE=30
IOT_DISK_ALERT_THRESHOLD=80
IOT_DISK_ALERT_FREE_THRESHOLD=70

IOT_ALLOW_AUTO_REGISTER_DEVICES=false
IOT_VERBOSE_HTTP_LOGS=false
IOT_QUERY_CACHE_ENABLED=true

