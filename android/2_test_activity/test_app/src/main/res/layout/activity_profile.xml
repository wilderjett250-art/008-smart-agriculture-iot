<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnProfileBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_card"
                android:contentDescription="返回"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@color/text_main" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="个人中心"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_main"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="修改密码"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_alt"
                android:hint="当前密码"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_muted" />

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_alt"
                android:hint="新密码"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_muted" />

            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="更新密码" />

            <TextView
                android:id="@+id/tvPasswordStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="数据导出"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExportHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="支持按分组、植株、设备和时间范围自定义导出。"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etExportGroupType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_alt"
                android:hint="分组，可填 stress 或 control"
                android:padding="14dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_muted" />

            <EditText
                android:id="@+id/etExportPlantCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_alt"
                android:hint="植株编号，例如 test_chr_001"
                android:padding="14dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_muted" />

            <EditText
                android:id="@+id/etExportDeviceCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_alt"
                android:hint="设备编号，例如 test_soil_001"
                android:padding="14dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_muted" />

            <EditText
                android:id="@+id/etExportStartTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_alt"
                android:hint="开始时间 YYYY-MM-DD HH:mm:ss"
                android:padding="14dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_muted" />

            <EditText
                android:id="@+id/etExportEndTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_alt"
                android:hint="结束时间 YYYY-MM-DD HH:mm:ss"
                android:padding="14dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_muted" />

            <Button
                android:id="@+id/btnExportCsv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="导出 CSV" />

            <Button
                android:id="@+id/btnExportExcel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="导出 Excel" />

            <TextView
                android:id="@+id/tvExportStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAdminUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="账号列表"
                    android:textColor="@color/text_main"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRefreshUsers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="刷新" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUserAdminHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="仅管理员可快速启用、停用或删除其他账号；当前账号和默认管理员不可操作。"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/layoutUserList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvUserListStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="退出登录" />
    </LinearLayout>
</ScrollView>
